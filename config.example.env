# Copy to config.env and edit. Sourced by collect.sh and build.sh.
HOSTS_FILE=hosts.txt
OUT=./out                       # raw/ (unscrubbed!), corpus/ (scrubbed) and graphify-out/ go here
PARALLEL=4                      # hosts collected at once
# Where self-written code lives on the servers (searched recursively, files < 400 KB).
INCLUDE_DIRS="/usr/local/bin /usr/local/sbin /usr/local/etc /opt /srv /root/bin /root/scripts"
# Directory names pruned anywhere under INCLUDE_DIRS (third-party code, caches, backups).
EXCLUDE_NAMES="venv .venv node_modules site-packages dist-packages __pycache__ .git containerd lib64 include build dist backups backup logs log cache .cache trash"
# Extra path regex dropped from the file list (big vendored apps you do not want in the graph).
EXCLUDE_REGEX='/opt/(containerd|nvidia)/'
# Local git checkouts whose committed files go into corpus/git/<name>; identical files on servers are skipped.
GIT_DIRS=""                     # e.g. "$HOME/src/infra-scripts $HOME/src/proxy-configs"
